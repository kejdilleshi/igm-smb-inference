\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Validation of the inferred SMB against the GLACIOCLIM stake network on Argentière Glacier (main trunk + Améthystes tributary) over 2012--2021. The three baselines are the modelling approaches of \citet  {kneib2024}, evaluated against the same stakes; all three use ice-thickness data, whereas our result uses surface velocity only. The GPR-assisted field inversion, which improves further on these, is reported in Appendix~\ref {app:gpr}.}}{11}{}\protected@file@percent }
\newlabel{tab:rmse}{{2}{11}{Inferred SMB and validation}{}{}}
\@writefile{toc}{\contentsline {subsection}{Inferred SMB and validation}{11}{}\protected@file@percent }
\newlabel{sec:inferred}{{}{11}{Inferred SMB and validation}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Inferred elevation-resolved SMB profile for Argentière Glacier over 2012--2021 (black), obtained with the generic velocity-only pipeline ($\tau _{\mathrm  {ref}}=0.27\,\mathrm  {MPa}$, no thickness data). Green diamonds are the 2012--2021 mean GLACIOCLIM stake balances, plotted at the elevation of each stake; the inferred profile reproduces them with $\mathrm  {RMSE}=0.65\,\mathrm  {m\,w.e.\,yr^{-1}}$. The dashed red curve is the SMB obtained from the continuity equation with a \emph  {stationary} data-assimilation flux divergence (as in geodetic flux-divergence inversions); it departs strongly in the ablation zone ($\mathrm  {RMSE}=2.14$), quantifying the stationary-flux bias that the transient inversion removes.}}{12}{}\protected@file@percent }
\newlabel{fig:smb-argentiere}{{3}{12}{Inferred SMB and validation}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Inferred SMB profile (black) for (a)~Great Aletsch and (b)~Rhône, compared against in situ stake measurements and against the continuity estimate $\mathrm  {d}h/\mathrm  {d}t + \nabla \!\cdot \mathbf  {q}$ (dashed) obtained with the \emph  {stationary} data-assimilation flux divergence. Faint grey dots are raw single-year stake readings; green diamonds are the continuous-record averages ($\pm $ interannual standard deviation), the validation targets. The inferred profile tracks the averages across the whole elevation range ($\mathrm  {RMSE}=0.61$ and $0.32\,\mathrm  {m\,w.e.\,yr^{-1}}$), whereas the stationary-flux estimate departs strongly in the ablation zone ($1.59$ and $1.63$).}}{13}{}\protected@file@percent }
\newlabel{fig:smb-continuity}{{4}{13}{Inferred SMB and validation}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Inferred SMB profiles across a range of basal sliding coefficients $\tau _{\mathrm  {ref}}$ for (a)~Argentière, (b)~Great Aletsch and (c)~Rhône; colour encodes $\tau _{\mathrm  {ref}}$ and the adopted profile is drawn bold. Within the low-velocity-misfit basin the profiles coincide in the accumulation area and diverge only at the ablation tongue, so the residual sliding uncertainty translates into an equilibrium-line-altitude band (shaded) rather than a whole-profile bias; the high-sliding runs (dashed), which the velocity misfit rejects, depart most strongly.}}{14}{}\protected@file@percent }
\newlabel{fig:sens}{{5}{14}{Sensitivity to the basal sliding coefficient}{}{}}
\@writefile{toc}{\contentsline {subsection}{Sensitivity to the basal sliding coefficient}{14}{}\protected@file@percent }
\newlabel{sec:sensitivity}{{}{14}{Sensitivity to the basal sliding coefficient}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Data-assimilation surface-velocity misfit (\emph  {velsurf} RMSE) against the independent stake RMSE, pooled over the sliding sweep (six runs per glacier, all three glaciers). Higher velocity misfit is associated with higher stake error (Pearson $r=0.69$, Spearman $\rho =0.63$), so the velocity misfit---the only selector available without stakes---carries usable information about the accuracy of the inferred SMB.}}{15}{}\protected@file@percent }
\newlabel{fig:corr}{{6}{15}{Sensitivity to the basal sliding coefficient}{}{}}
