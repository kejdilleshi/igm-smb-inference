\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Inferred SMB profile (black) for (a)~Argentière, (b)~Great Aletsch and (c)~Rhône, compared against in situ stake measurements and against the continuity estimate $\mathrm  {d}h/\mathrm  {d}t + \nabla \!\cdot \mathbf  {q}$ (dashed) obtained with the \emph  {stationary} data-assimilation flux divergence. Green diamonds are the continuous-record stake averages ($\pm $ interannual standard deviation), the validation targets (faint grey dots on Aletsch and Rhône are the raw single-year readings). The inferred profile tracks the averages across the whole elevation range ($\mathrm  {RMSE}=0.40$, $0.52$ and $0.60\,\mathrm  {m\,w.e.\,yr^{-1}}$), whereas the stationary-flux estimate departs strongly in the ablation zone ($0.98$, $1.13$ and $1.53$).}}{13}{figure.caption.8}\protected@file@percent }
\newlabel{fig:smb-continuity}{{6}{13}{Inferred SMB profile (black) for (a)~Argentière, (b)~Great Aletsch and (c)~Rhône, compared against in situ stake measurements and against the continuity estimate $\mathrm {d}h/\mathrm {d}t + \nabla \!\cdot \mathbf {q}$ (dashed) obtained with the \emph {stationary} data-assimilation flux divergence. Green diamonds are the continuous-record stake averages ($\pm $ interannual standard deviation), the validation targets (faint grey dots on Aletsch and Rhône are the raw single-year readings). The inferred profile tracks the averages across the whole elevation range ($\mathrm {RMSE}=0.40$, $0.52$ and $0.60\,\mathrm {m\,w.e.\,yr^{-1}}$), whereas the stationary-flux estimate departs strongly in the ablation zone ($0.98$, $1.13$ and $1.53$)}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Sensitivity to the basal-motion parameter}{13}{subsection.3.3}\protected@file@percent }
\newlabel{sec:sensitivity}{{3.3}{13}{Sensitivity to the basal-motion parameter}{subsection.3.3}{}}
\citation{kneib2024}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Inferred SMB profiles across a range of the basal-motion parameter $\tau _{\mathrm  {ref}}$ for (a)~Argentière, (b)~Great Aletsch and (c)~Rhône; colour encodes $\tau _{\mathrm  {ref}}$ and the adopted profile is drawn bold. Within the low-velocity-misfit basin the profiles coincide in the accumulation area and diverge only at the ablation tongue, so the residual uncertainty in $\tau _{\mathrm  {ref}}$ translates into an equilibrium-line-altitude band (shaded) rather than a whole-profile bias; the runs the velocity misfit rejects (dashed) depart most strongly.}}{14}{figure.caption.9}\protected@file@percent }
\newlabel{fig:sens}{{7}{14}{Inferred SMB profiles across a range of the basal-motion parameter $\tau _{\mathrm {ref}}$ for (a)~Argentière, (b)~Great Aletsch and (c)~Rhône; colour encodes $\tau _{\mathrm {ref}}$ and the adopted profile is drawn bold. Within the low-velocity-misfit basin the profiles coincide in the accumulation area and diverge only at the ablation tongue, so the residual uncertainty in $\tau _{\mathrm {ref}}$ translates into an equilibrium-line-altitude band (shaded) rather than a whole-profile bias; the runs the velocity misfit rejects (dashed) depart most strongly}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Data-assimilation surface-velocity misfit (\emph  {velsurf} RMSE) against the independent stake RMSE across the $\tau _{\mathrm  {ref}}$ sweep, shown separately for each glacier. Higher velocity misfit is associated with higher stake error on all three (Pearson $r=0.99$, $0.72$ and $0.81$; Spearman $\rho =0.83$, $0.38$ and $0.71$, for Argentière, Aletsch and Rhône respectively), so the velocity misfit---the only selector available without stakes---carries usable information about the accuracy of the inferred SMB.}}{15}{figure.caption.10}\protected@file@percent }
\newlabel{fig:corr}{{8}{15}{Data-assimilation surface-velocity misfit (\emph {velsurf} RMSE) against the independent stake RMSE across the $\tau _{\mathrm {ref}}$ sweep, shown separately for each glacier. Higher velocity misfit is associated with higher stake error on all three (Pearson $r=0.99$, $0.72$ and $0.81$; Spearman $\rho =0.83$, $0.38$ and $0.71$, for Argentière, Aletsch and Rhône respectively), so the velocity misfit---the only selector available without stakes---carries usable information about the accuracy of the inferred SMB}{figure.caption.10}{}}
